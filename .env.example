# Copy this file to .env and replace each placeholder, or run scripts/setup_stage3.py.
DB_PASSWORD=replace-with-random-password
MQ_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
CATVISION_MODEL_ROOT=./weights
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Optional package mirrors for image builds; CUDA wheels default to PyTorch's own index.
CATVISION_PIP_INDEX_URL=https://pypi.org/simple
CATVISION_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
CATVISION_DEBIAN_MIRROR=https://deb.debian.org
